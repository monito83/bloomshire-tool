{
  "manifest_version": 3,
  "name": "Bloomshire Master Companion",
  "version": "1.3.0",
  "description": "Extensión dedicada para Bloomshire (Season 0): sincroniza en vivo tu partida con Bloomshire Tool (bloomshire-tool.vercel.app).",
  "permissions": [
    "storage",
    "tabs",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "*://bloomshire.xyz/*",
    "*://*.bloomshire.xyz/*",
    "*://bloomshire.io/*",
    "*://*.bloomshire.io/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://bloomshire-tool.vercel.app/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://bloomshire.xyz/*",
        "*://*.bloomshire.xyz/*",
        "*://bloomshire.io/*",
        "*://*.bloomshire.io/*"
      ],
      "all_frames": false,
      "js": [
        "content_hook.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://bloomshire.xyz/*",
        "*://*.bloomshire.xyz/*",
        "*://bloomshire.io/*",
        "*://*.bloomshire.io/*"
      ],
      "all_frames": false,
      "js": [
        "content_bridge.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*",
        "https://bloomshire-tool.vercel.app/*"
      ],
      "all_frames": false,
      "js": [
        "content_monios.js"
      ],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Bloomshire Companion",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "quests_es.json"
      ],
      "matches": [
        "*://bloomshire.xyz/*",
        "*://*.bloomshire.xyz/*",
        "*://bloomshire.io/*",
        "*://*.bloomshire.io/*"
      ]
    }
  ]
}
